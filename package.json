{
  "name": "elevate-hrg",
  "version": "0.1.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rimraf .next && next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "check:images": "node scripts/check-project-images.cjs",
    "check:email": "node scripts/check-email-auth.mjs",
    "test:lead": "node scripts/send-test-lead.mjs",
    "brevo:status": "node scripts/brevo-status.mjs",
    "leads:recover": "node scripts/recover-lost-leads.mjs",
    "leads:export": "node scripts/export-submissions.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:mobile": "playwright test --project \"Mobile Chrome\" --project \"Mobile Safari\"",
    "test:e2e:responsive": "playwright test tests/e2e/mobile-layout.spec.ts --project \"Mobile Chrome\" --project \"Mobile Safari\" --project \"Desktop Firefox\"",
    "verify": "node scripts/verify.mjs",
    "verify:quick": "node scripts/verify.mjs --level=quick",
    "verify:report": "node scripts/verify-status.mjs",
    "lhci": "next build && lhci autorun",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3",
    "@babel/core": "^7.29.7",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1",
    "js-yaml": "^3.15.0",
    "inquirer": "^8.2.7",
    "express": "^4.22.2",
    "qs": "^6.15.3",
    "body-parser": "^1.20.6",
    "ws": "^8.21.1",
    "chrome-launcher": "^1.2.1",
    "playwright-core": "1.59.1",
    "eslint": {
      "minimatch": "^10.2.5"
    },
    "eslint-config-next": {
      "minimatch": "^10.2.5"
    }
  },
  "dependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@gsap/react": "2.1.2",
    "@hookform/resolvers": "5.2.2",
    "@netlify/blobs": "^11.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "embla-carousel-react": "8.6.0",
    "gsap": "3.15.0",
    "lenis": "1.3.23",
    "lucide-react": "1.14.0",
    "motion": "12.38.0",
    "next": "16.2.12",
    "next-themes": "0.4.6",
    "ogl": "1.0.11",
    "radix-ui": "1.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.75.0",
    "schema-dts": "^2.0.0",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0",
    "web-vitals": "5.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@next/bundle-analyzer": "16.2.6",
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "20.19.40",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "10.8.0",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "10.1.8",
    "husky": "^9.1.7",
    "lighthouse": "13.4.1",
    "lint-staged": "^17.0.4",
    "playwright": "1.59.1",
    "prettier": "3.8.3",
    "rimraf": "^6.0.1",
    "tailwindcss": "4.2.0",
    "typescript": "6.0.3"
  }
}
