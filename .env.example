# --- Lead capture (Website service) ---
# Transactional email delivery for the contact/quote forms. The sales inbox is
# the record of truth (no database). Until BREVO_API_KEY, LEADS_TO_EMAIL, and
# LEADS_FROM_EMAIL are ALL set, the API returns an honest failure and the form
# shows a "call us" fallback rather than a fake thank-you.
#
# BREVO IS THE ACTIVE PROVIDER. lib/lead-delivery.ts tries Brevo first and falls
# back to Resend, and only attempts a provider whose variables are ALL present —
# so BREVO_API_KEY alone is enough to switch. Get the key and verify the sender
# at https://brevo.com (Senders, Domains & Dedicated IPs). An unverified sender
# is the most common cause of a 400 back from their API.
BREVO_API_KEY=

# Recipients. BOTH of these accept a comma-separated LIST, and every address on
# the list gets a copy. Use that: the inbox is the record of truth, so a second
# inbox on an unrelated provider is the difference between a lead arriving late
# and a lead being lost. Malformed entries are dropped, not fatal.
LEADS_TO_EMAIL=          # sales inbox(es), e.g. sales@example.com,you@example.com
CAREERS_TO_EMAIL=        # optional - hiring inbox(es); falls back to LEADS_TO_EMAIL

# The SENDING identity. It does NOT have to be on the same domain as the
# recipients above - Reply-To is already the customer's own address.
#
# This MUST be either a verified sender in Brevo, or an address on a domain
# Brevo has authenticated. Anything else is rejected - and rejected the worst
# possible way: Brevo returns 2xx accepting the request, then drops it
# asynchronously.
#
# lib/brevo-sender.ts now preflights this on first send and refuses rather than
# reporting a false success, so a bad value here surfaces as a 502 and a logged,
# recoverable payload instead of silence. Check any value with:
#   npm run brevo:status
LEADS_FROM_EMAIL=        # e.g. leads@example.com once that domain is authenticated

# --- Reading the durable archive (LOCAL TOOLING ONLY) ---
# lib/submission-archive.ts writes every lead and application to Netlify Blobs
# before delivery is attempted, so a submission survives total email failure.
# Production needs NOTHING here — the Netlify runtime supplies the context.
# These two are required only to run `npm run leads:export` from a laptop.
NETLIFY_SITE_ID=         # Netlify -> Site configuration -> General
NETLIFY_AUTH_TOKEN=      # Netlify -> User settings -> Personal access tokens

# Optional fallback only. Leave empty unless deliberately moving off Brevo —
# Resend is attempted second, and only if all three of its variables are set.
RESEND_API_KEY=

# --- CRM / marketing pipeline (optional) ---
# Not wired yet. To sync leads to a CRM, add its credentials here and register
# a provider in lib/lead-delivery.ts.
CRM_PROVIDER=
CRM_API_KEY=

# --- SMS "Join the Club" (separate, currently stubbed) ---
SMS_PROVIDER=
SMS_ON_CALL_NUMBER=

# --- Spam protection (optional) ---
RECAPTCHA_SECRET_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --- Analytics ---
# GA4 is LIVE in production. The measurement ID is G-PTJ4Z4E9KJ — it does NOT
# belong in this file (this is the committed template); put it in .env.local for
# local work and in the Netlify environment for deploys.
#
# ⚠️ NEXT_PUBLIC_* values are STRING-INLINED AT BUILD TIME into HTML that is then
# cached. Setting this in the Netlify UI does nothing until a rebuild — and a
# plain "Deploy site" can reuse the cached .next and ship the old empty value.
# Use Deploys → Trigger deploy → "Clear cache and deploy site", then verify by
# viewing source and grepping for the ID rather than trusting the env UI.
#
# Consent Mode v2 gates GA4 rather than the script tag: gtag.js loads whenever
# this ID is set, and lib/consent.ts + components/consent/* decide what it is
# allowed to do. Analytics defaults to granted, advertising to denied, and
# Global Privacy Control is honored. See docs/GA4_CONSENT_IMPLEMENTATION_PLAN.md.
NEXT_PUBLIC_GA4_ID=

# Tags every hit from this environment with `traffic_type`, so GA4 can filter it
# out. CI sets this to "internal" because .github/workflows/ci.yml builds with
# the REAL measurement ID — that is deliberate (Lighthouse must measure gtag.js's
# true ~90 KB / 60–120 ms cost, otherwise the performance gate is a fiction), but
# it means CI page loads reach the production property.
#
# ⚠️ OWNER ACTION REQUIRED — the filter is not automatic. In GA4:
#   Admin → Data collection and modification → Data filters → Create filter
#   → "Internal Traffic" → parameter value `internal` → set to Active.
# Until that filter is Active, CI traffic WILL appear in reports. Leave this
# empty in production.
NEXT_PUBLIC_ANALYTICS_TRAFFIC_TYPE=

# --- Analytics: deliberately deferred ---
# These are NOT wired and are not planned for now. Each was evaluated and
# deferred with a reason — see docs/GA4_CONSENT_IMPLEMENTATION_PLAN.md §1:
#   GTM        — a tag-orchestration layer for a site with one tag; a second
#                runtime and a second injection surface for no current benefit.
#   Clarity    — session recording materially widens what the privacy policy
#                must disclose, and adds a DOM-mutation observer on top of an
#                already heavy motion stack. Revisit in ~60 days.
#   CallRail   — paid, and its dynamic number insertion rewrites the DOM after
#                load, which is directly hostile to the 0.1 CLS budget.
# Setting any of these does nothing today; the code to read them does not exist.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_CALLRAIL_NUMBER=

# --- Misc ---
DATABASE_URL=
